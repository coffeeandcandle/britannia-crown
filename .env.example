# Online payments (Stripe). Leave unset to keep buy buttons as enquiry links.
# Add these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Use test keys (sk_test_..., from Stripe test mode) first; switch to live keys when ready.
STRIPE_SECRET_KEY=
# Optional. Production deploys create the webhook and billing portal automatically
# (scripts/stripe-setup.mjs) and keep the signing secret in the database. Only set this
# if you create the webhook yourself, e.g. for `stripe listen` during local development.
STRIPE_WEBHOOK_SECRET=

# Client portal (/portal). Leave unset to show the "portal is on its way" page.
# Clerk: create an application at clerk.com, then copy the keys from API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal/sign-in
# Neon Postgres (Vercel → Storage → Neon). Use the pooled connection string.
DATABASE_URL=
# Comma-separated emails that get admin access the first time they sign in.
ADMIN_EMAILS=

# Email alerts for website enquiries and orders (resend.com). Without a key, enquiries are
# still saved in the portal CRM (Staff area → Contacts), just not emailed.
RESEND_API_KEY=
# Who gets the alerts (comma-separated). Defaults to hello@britanniacrown.com.
NOTIFY_EMAIL=
# Sender, once britanniacrown.com is verified in Resend, e.g. Britannia Crown <hello@britanniacrown.com>
EMAIL_FROM=
