# Online payments (Stripe). Leave unset to keep buy buttons as enquiry links.
# Add these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Use test keys (sk_test_..., from Stripe test mode) first; switch to live keys when ready.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → endpoint https://www.britanniacrown.com/api/stripe/webhook
# Events: checkout.session.completed, invoice.payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
