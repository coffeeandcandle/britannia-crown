# Online payments (Stripe). Leave unset to keep buy buttons as enquiry links.
# Add these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Use test keys (sk_test_..., from Stripe test mode) first; switch to live keys when ready.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → endpoint https://www.britanniacrown.com/api/stripe/webhook
# Events: checkout.session.completed, invoice.payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Client portal (/portal). Leave unset to show the "portal is on its way" page.
# Clerk: create an application at clerk.com, then copy the keys from API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal/sign-in
# Neon Postgres (Vercel → Storage → Neon). Use the pooled connection string.
DATABASE_URL=
# Comma-separated emails that get admin access the first time they sign in.
ADMIN_EMAILS=
